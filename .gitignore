# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/
.vite/
.astro/
.scratch/
playwright-report/
test-results/
webapp/e2e/.artifacts/
.lighthouseci/

# Runtime and logs
*.log
npm-debug.log*
yarn-debug.log*
bun-debug.log*

# Environment files
# Never commit a real environment file. Only *.example files are tracked.
.env
.env.*
!backend/.env*.example
!webapp/.env*.example
!website/.env*.example

# Secrets and credentials
# Belt and braces: these patterns must never appear in the repository.
*.pem
*.key
*.p12
*.pfx
*.session
secrets/
.secrets/
service-account*.json
authorized_key*.json

# Prisma generated client
backend/src/generated/prisma/
backend/.prisma-generate.lock

# Local object storage driver
backend/.storage/
webapp/.storage/

# Generated static website output before upload
website/dist/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
