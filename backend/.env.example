# ─────────────────────────────────────────────────────────────────────────────
# Pipupi — backend environment template
#
# Copy to backend/.env and fill in the placeholders. backend/.env is git-ignored
# and must never be committed. Real credentials live only in that file locally and
# in the platform secret store in production.
#
# Every value marked REPLACE_ME is a placeholder, not a secret.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── Local PostgreSQL (Docker Compose) ────────────────────────────────────────
# These match docker-compose.yml. Changing one means changing both, plus
# docs/LOCAL_DATABASE.md — scripts/repo-env.mjs fails when they drift apart.
POSTGRES_DB=pipupi
POSTGRES_TEST_DB=pipupi_test
POSTGRES_USER=pipupi
POSTGRES_PASSWORD=pipupi_local_password
POSTGRES_PORT=54329
POSTGRES_TEST_PORT=54330

# Local development credentials are not secrets: they reach nothing but a container
# on this machine. Production uses the platform secret store.
DATABASE_URL=postgresql://pipupi:pipupi_local_password@localhost:54329/pipupi
TEST_DATABASE_URL=postgresql://pipupi:pipupi_local_password@localhost:54330/pipupi_test

# ── Public addresses (local development) ─────────────────────────────────────
# Production values live in docs/DOMAINS.md.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080

# ── CORS: two separate policies, see docs/DOMAINS.md section 5 ───────────────
# Public endpoints run without credentials; application endpoints run with them.
CORS_PUBLIC_ORIGINS=http://localhost:4321
CORS_APP_ORIGINS=http://localhost:5173

# ── Authentication cookie ────────────────────────────────────────────────────
# Host-only for api.pipupi.ru: AUTH_COOKIE_DOMAIN is deliberately ABSENT and adding
# it changes the security model. Path must stay "/" so the cookie reaches every
# authenticated route, not only /api/auth/*. See docs/DOMAINS.md section 4.
AUTH_COOKIE_NAME=pip_rt
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAMESITE=lax
# false is allowed locally only; production must set true.
AUTH_COOKIE_SECURE=false

# ── Sessions and tokens ──────────────────────────────────────────────────────
JWT_SECRET=REPLACE_ME
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
SESSION_RETENTION_DAYS=30
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXY_CLIENT_IP_HEADER=x-forwarded-for

# ── LLM provider ─────────────────────────────────────────────────────────────
# Configuration only. The adapter itself arrives in Wave 4.
# The key is never stored in this repository — leave it empty here.
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MONTHLY_COST_CAP_RUB=
LLM_DRY_RUN=false

# ── Keyword source ───────────────────────────────────────────────────────────
KEYWORDS_PROVIDER=csv
KEYWORDS_CSV_MAX_ROWS=50000

# ── Publishing and object storage ────────────────────────────────────────────
PUBLISH_TARGET=internal_website
PRIVATE_STORAGE_DRIVER=filesystem
PRIVATE_STORAGE_ENDPOINT=
PRIVATE_STORAGE_REGION=
PRIVATE_STORAGE_BUCKET=
PRIVATE_STORAGE_ACCESS_KEY_ID=
PRIVATE_STORAGE_SECRET_ACCESS_KEY=
PUBLIC_SITE_BUCKET=
CDN_RESOURCE_ID=

# ── Attribution ──────────────────────────────────────────────────────────────
ATTRIBUTION_COOKIE_NAME=pip_vid
ATTRIBUTION_COOKIE_TTL_DAYS=90
ATTRIBUTION_MODEL=first_last

# ── Consent and policy versions ──────────────────────────────────────────────
CONSENT_TEXT_VERSION=2026-08-01
PRIVACY_POLICY_VERSION=2026-08-01

# ── Compliance guards ────────────────────────────────────────────────────────
# These three are validated at process start. A value that disagrees with the
# project phase is a refusal to boot, not a warning in the log.
# See docs/COMPLIANCE.md section 6. scripts/repo-env.mjs enforces them here.
REQUIRE_HUMAN_APPROVAL=true
OUTBOUND_MESSAGING_ENABLED=false
PII_TO_LLM_ALLOWED=false
