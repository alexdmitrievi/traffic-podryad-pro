// Pipupi — database schema.
//
// Conventions that hold everywhere in this file:
//
//   - Primary keys are UUIDv7 generated by the application through Prisma Client
//     (`@default(uuid(7))`) and stored in a native `uuid` column. The production PostgreSQL
//     version is still unverified (docs/DEPLOYMENT.md section 3), and application-side
//     generation is the option that works on every version. Direct writes bypassing the
//     backend are forbidden — that is the condition making this correct, not a preference.
//
//   - Every product table carries `workspace_id`. The MVP runs one workspace and has no
//     isolation logic; the column exists from day one because adding it later is a migration
//     across every table at once.
//
//   - A closed set of values is a PostgreSQL enum. An open one is a text column validated in
//     code against a registry, so adding a value stays a code change rather than an
//     irreversible ALTER TYPE.
//
//   - NO VECTOR COLUMNS AND NO EXTENSIONS. Clustering is intended to run on embeddings in
//     PostgreSQL, but the production pgvector gate is unresolved. Shipping an embedding
//     column now means the first migration to reach production fails on a missing extension,
//     after the rest of the schema already landed. scripts/repo-env.mjs fails the build if
//     one appears here.
//
// Migrations are not created in this wave.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// WORKSPACE
// =============================================================================

/// The tenant boundary. One row in the MVP; the column exists everywhere so a second one is
/// a product decision rather than a schema migration.
model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  locale    String   @default("ru")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  verticals         Vertical[]
  regions           Region[]
  productCategories ProductCategory[]
  products          Product[]
  deliveryBases     DeliveryBasis[]
  serviceRequests   ServiceRequest[]
  keywords          Keyword[]
  topicClusters     TopicCluster[]
  contentBriefs     ContentBrief[]
  contentItems      ContentItem[]
  leads             Lead[]
  approvals         Approval[]
  llmRuns           LlmRun[]
  auditEntries      AuditLog[]
  evidenceSources   EvidenceSource[]
  claims            Claim[]
  citations         Citation[]

  @@map("workspaces")
}

// =============================================================================
// AUTH AND USERS
// =============================================================================

/// Roles are resolved from the active session on every request and never encoded in a token,
/// so a demotion takes effect immediately.
enum UserRole {
  admin
  editor
  viewer

  @@map("user_role")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  displayName  String?  @map("display_name")
  role         UserRole @default(viewer)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  approvals           Approval[]
  serviceRequests     ServiceRequest[]     @relation("ServiceRequestRequester")
  contentRevisions    ContentRevision[]
  publications        Publication[]
  auditEntries        AuditLog[]
  evidenceSourcesVerified EvidenceSource[] @relation("EvidenceSourceVerifier")
  claimsVerified      Claim[]             @relation("ClaimVerifier")

  @@index([role], map: "users_role_idx")
  @@map("users")
}

/// Refresh credentials are opaque; only hashes are stored. The previous hash is kept so a
/// rotation race does not log an honest client out, and its reuse outside a short window is
/// treated as compromise.
model AuthSession {
  id                       String    @id @default(uuid(7)) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash")
  previousRefreshTokenHash String?   @unique(map: "auth_sessions_previous_refresh_token_hash_key") @map("previous_refresh_token_hash")
  refreshRotatedAt         DateTime? @map("refresh_rotated_at")
  expiresAt                DateTime  @map("expires_at")
  revokedAt                DateTime? @map("revoked_at")
  userAgent                String?   @map("user_agent")
  ipAddress                String?   @map("ip_address")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "password_reset_tokens_user_id_fkey")

  @@index([userId, createdAt], map: "password_reset_tokens_user_id_created_at_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

// =============================================================================
// CATALOG
//
// Generic taxonomy of what a workspace sells. Petroleum wholesale is the first vertical we
// validate on — a row in `verticals`, not a shape in this schema. Nothing below names a fuel,
// a grade or a delivery term, so a second vertical is seed data plus a workspace.
// =============================================================================

model Vertical {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "verticals_workspace_id_fkey")
  categories    ProductCategory[]
  deliveryBases DeliveryBasis[]

  @@unique([workspaceId, code], map: "verticals_workspace_id_code_key")
  @@map("verticals")
}

/// Hierarchical: federal district -> subject -> city. The seed fills districts and the cities
/// we sell into; the subject level appears when a real keyword asks for it.
enum RegionKind {
  country
  federal_district
  subject
  city

  @@map("region_kind")
}

model Region {
  id          String     @id @default(uuid(7)) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  code        String
  name        String
  kind        RegionKind
  parentId    String?    @map("parent_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "regions_workspace_id_fkey")
  parent    Region?   @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull, map: "regions_parent_id_fkey")
  children  Region[]  @relation("RegionTree")

  keywords      Keyword[]
  topicClusters TopicCluster[]
  contentItems  ContentItem[]
  leads         Lead[]

  @@unique([workspaceId, code], map: "regions_workspace_id_code_key")
  @@index([workspaceId, kind], map: "regions_workspace_id_kind_idx")
  @@map("regions")
}

enum MeasurementUnit {
  tonne
  litre
  cubic_metre
  kilogram
  piece

  @@map("measurement_unit")
}

model ProductCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  verticalId  String   @map("vertical_id") @db.Uuid
  code        String
  name        String
  slug        String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "product_categories_workspace_id_fkey")
  vertical  Vertical  @relation(fields: [verticalId], references: [id], onDelete: Cascade, map: "product_categories_vertical_id_fkey")
  products  Product[]

  @@unique([workspaceId, code], map: "product_categories_workspace_id_code_key")
  @@unique([workspaceId, slug], map: "product_categories_workspace_id_slug_key")
  @@map("product_categories")
}

/// Deliberately absent: specifications, grades, standards, temperature ranges and prices.
/// Those are facts a person verifies against a source before publication, and a column here
/// would invite a model to fill it. See docs/PETROLEUM_TAXONOMY.md.
model Product {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  categoryId  String          @map("category_id") @db.Uuid
  name        String
  slug        String
  unit        MeasurementUnit
  /// Alternative spellings used to attach imported keywords automatically. Not shown to users.
  synonyms    String[]        @default([])
  createdAt   DateTime        @default(now()) @map("created_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "products_workspace_id_fkey")
  category  ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "products_category_id_fkey")

  keywords      Keyword[]
  topicClusters TopicCluster[]
  contentItems  ContentItem[]
  leads         Lead[]

  @@unique([workspaceId, slug], map: "products_workspace_id_slug_key")
  @@index([workspaceId, categoryId], map: "products_workspace_id_category_id_idx")
  @@map("products")
}

/// Workspace data rather than an enum: the list differs per vertical. This is a picker in a
/// form and carries no contractual meaning — the contract does.
model DeliveryBasis {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  verticalId  String   @map("vertical_id") @db.Uuid
  code        String
  name        String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "delivery_bases_workspace_id_fkey")
  vertical  Vertical  @relation(fields: [verticalId], references: [id], onDelete: Cascade, map: "delivery_bases_vertical_id_fkey")
  leads     Lead[]

  @@unique([workspaceId, code], map: "delivery_bases_workspace_id_code_key")
  @@map("delivery_bases")
}

// =============================================================================
// SERVICE REQUESTS
// =============================================================================

enum ServiceLine {
  seo_content
  b2b_outreach
  telegram_marketing
  complex_package

  @@map("service_line")
}

/// `planned_awaiting_capability` is terminal and intentional, not an error: the plan is
/// approved and the product deliberately has no way to execute it. It exists so a deliberate
/// stop is distinguishable from a request nobody noticed was stuck.
enum ServiceRequestStatus {
  draft
  submitted
  triage
  accepted
  rejected
  planning
  plan_approved
  in_delivery
  delivered
  planned_awaiting_capability
  partially_delivered
  on_hold
  cancelled

  @@map("service_request_status")
}

enum PlanStatus {
  draft
  approved

  @@map("plan_status")
}

enum AuthorKind {
  human
  llm

  @@map("author_kind")
}

model ServiceRequest {
  id              String               @id @default(uuid(7)) @db.Uuid
  workspaceId     String               @map("workspace_id") @db.Uuid
  requestNumber   String               @map("request_number")
  serviceLine     ServiceLine          @map("service_line")
  verticalId      String?              @map("vertical_id") @db.Uuid
  title           String
  objective       String
  targetRegionIds String[]             @default([]) @map("target_region_ids") @db.Uuid
  locale          String               @default("ru")
  status          ServiceRequestStatus @default(draft)
  statusReason    String?              @map("status_reason")
  requestedById   String               @map("requested_by_id") @db.Uuid
  parentRequestId String?              @map("parent_request_id") @db.Uuid
  originLeadId    String?              @map("origin_lead_id") @db.Uuid
  deadlineHint    DateTime?            @map("deadline_hint")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "service_requests_workspace_id_fkey")
  requestedBy   User             @relation("ServiceRequestRequester", fields: [requestedById], references: [id], map: "service_requests_requested_by_id_fkey")
  parentRequest ServiceRequest?  @relation("ServiceRequestTree", fields: [parentRequestId], references: [id], onDelete: SetNull, map: "service_requests_parent_request_id_fkey")
  childRequests ServiceRequest[] @relation("ServiceRequestTree")
  originLead    Lead?            @relation(fields: [originLeadId], references: [id], onDelete: SetNull, map: "service_requests_origin_lead_id_fkey")

  plans         ServiceRequestPlan[]
  events        ServiceRequestEvent[]
  topicClusters TopicCluster[]
  keywords      Keyword[]

  @@unique([workspaceId, requestNumber], map: "service_requests_workspace_id_request_number_key")
  @@index([workspaceId, status], map: "service_requests_workspace_id_status_idx")
  @@index([workspaceId, serviceLine], map: "service_requests_workspace_id_service_line_idx")
  @@map("service_requests")
}

/// Versioned. A new plan is a new row: the previous version stays readable, which is what
/// makes an approval bound to a hash meaningful.
model ServiceRequestPlan {
  id          String      @id @default(uuid(7)) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  requestId   String      @map("request_id") @db.Uuid
  version     Int
  planKind    ServiceLine @map("plan_kind")
  /// Shape is enforced by the discriminated union in @traffic/contracts. Note what the
  /// outreach and Telegram shapes do not have: a recipients field. A plan describes an
  /// audience and never enumerates one.
  content     Json
  contentHash String      @map("content_hash")
  authorKind  AuthorKind  @map("author_kind")
  authorId    String?     @map("author_id") @db.Uuid
  llmRunId    String?     @map("llm_run_id") @db.Uuid
  status      PlanStatus  @default(draft)
  createdAt   DateTime    @default(now()) @map("created_at")

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, map: "service_request_plans_request_id_fkey")
  llmRun  LlmRun?        @relation(fields: [llmRunId], references: [id], onDelete: SetNull, map: "service_request_plans_llm_run_id_fkey")

  @@unique([requestId, version], map: "service_request_plans_request_id_version_key")
  @@index([workspaceId, status], map: "service_request_plans_workspace_id_status_idx")
  @@map("service_request_plans")
}

/// Append-only. Never updated, never deleted.
model ServiceRequestEvent {
  id          String                @id @default(uuid(7)) @db.Uuid
  workspaceId String                @map("workspace_id") @db.Uuid
  requestId   String                @map("request_id") @db.Uuid
  fromStatus  ServiceRequestStatus? @map("from_status")
  toStatus    ServiceRequestStatus  @map("to_status")
  reason      String?
  actorId     String?               @map("actor_id") @db.Uuid
  occurredAt  DateTime              @default(now()) @map("occurred_at")

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, map: "service_request_events_request_id_fkey")

  @@index([requestId, occurredAt], map: "service_request_events_request_id_occurred_at_idx")
  @@map("service_request_events")
}

// =============================================================================
// RESEARCH
// =============================================================================

enum KeywordIntent {
  informational
  commercial
  transactional
  navigational
  unknown

  @@map("keyword_intent")
}

enum KeywordSource {
  csv_import
  manual

  @@map("keyword_source")
}

model Keyword {
  id               String        @id @default(uuid(7)) @db.Uuid
  workspaceId      String        @map("workspace_id") @db.Uuid
  requestId        String?       @map("request_id") @db.Uuid
  phrase           String
  /// Case-folded and whitespace-collapsed. The deduplication key, not a display value.
  normalizedPhrase String        @map("normalized_phrase")
  locale           String        @default("ru")
  intent           KeywordIntent @default(unknown)
  productId        String?       @map("product_id") @db.Uuid
  regionId         String?       @map("region_id") @db.Uuid
  source           KeywordSource @default(csv_import)
  importedAt       DateTime      @default(now()) @map("imported_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "keywords_workspace_id_fkey")
  request   ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull, map: "keywords_request_id_fkey")
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull, map: "keywords_product_id_fkey")
  region    Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull, map: "keywords_region_id_fkey")

  metrics        KeywordMetric[]
  clusterLinks   ClusterKeyword[]
  pillarClusters TopicCluster[]   @relation("ClusterPillarKeyword")

  @@unique([workspaceId, normalizedPhrase, locale], map: "keywords_workspace_id_normalized_phrase_locale_key")
  @@index([workspaceId, productId], map: "keywords_workspace_id_product_id_idx")
  @@index([workspaceId, regionId], map: "keywords_workspace_id_region_id_idx")
  @@map("keywords")
}

/// A snapshot, never an update in place. Volume moving over time is the signal the pipeline
/// acts on; overwriting would discard it on every import.
model KeywordMetric {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  keywordId   String   @map("keyword_id") @db.Uuid
  provider    String
  volume      Int?
  difficulty  Decimal? @db.Decimal(5, 2)
  capturedAt  DateTime @default(now()) @map("captured_at")

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade, map: "keyword_metrics_keyword_id_fkey")

  @@unique([keywordId, provider, capturedAt], map: "keyword_metrics_keyword_id_provider_captured_at_key")
  @@index([keywordId, capturedAt], map: "keyword_metrics_keyword_id_captured_at_idx")
  @@map("keyword_metrics")
}

enum TopicClusterStatus {
  draft
  selected
  briefed
  published
  archived

  @@map("topic_cluster_status")
}

/// No embedding column. Clustering is intended to run on embeddings in PostgreSQL, but the
/// production pgvector gate is unresolved (docs/DEPLOYMENT.md section 3). A cluster is defined
/// by its membership and its pillar keyword, which stays true whichever way similarity is
/// computed. The column is added in the wave that answers the gate, not before.
model TopicCluster {
  id              String             @id @default(uuid(7)) @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  requestId       String             @map("request_id") @db.Uuid
  title           String
  summary         String?
  pillarKeywordId String?            @map("pillar_keyword_id") @db.Uuid
  productId       String?            @map("product_id") @db.Uuid
  regionId        String?            @map("region_id") @db.Uuid
  status          TopicClusterStatus @default(draft)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "topic_clusters_workspace_id_fkey")
  request       ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, map: "topic_clusters_request_id_fkey")
  pillarKeyword Keyword?       @relation("ClusterPillarKeyword", fields: [pillarKeywordId], references: [id], onDelete: SetNull, map: "topic_clusters_pillar_keyword_id_fkey")
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull, map: "topic_clusters_product_id_fkey")
  region        Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull, map: "topic_clusters_region_id_fkey")

  keywords ClusterKeyword[]
  briefs   ContentBrief[]

  @@index([workspaceId, status], map: "topic_clusters_workspace_id_status_idx")
  @@index([requestId], map: "topic_clusters_request_id_idx")
  @@map("topic_clusters")
}

model ClusterKeyword {
  clusterId String  @map("cluster_id") @db.Uuid
  keywordId String  @map("keyword_id") @db.Uuid
  relevance Decimal @db.Decimal(4, 3)

  cluster TopicCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade, map: "cluster_keywords_cluster_id_fkey")
  keyword Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade, map: "cluster_keywords_keyword_id_fkey")

  @@id([clusterId, keywordId])
  @@index([keywordId], map: "cluster_keywords_keyword_id_idx")
  @@map("cluster_keywords")
}

// =============================================================================
// CONTENT
// =============================================================================

enum BriefStatus {
  draft
  in_review
  approved
  rejected

  @@map("brief_status")
}

enum ContentStatus {
  draft
  in_review
  approved
  published
  archived

  @@map("content_status")
}

model ContentBrief {
  id               String      @id @default(uuid(7)) @db.Uuid
  workspaceId      String      @map("workspace_id") @db.Uuid
  clusterId        String      @map("cluster_id") @db.Uuid
  title            String
  /// Sections, each able to mark facts a person must verify before publication.
  outline          Json
  targetKeywordIds String[]    @default([]) @map("target_keyword_ids") @db.Uuid
  audience         String?
  tone             String?
  status           BriefStatus @default(draft)
  authorKind       AuthorKind  @map("author_kind")
  llmRunId         String?     @map("llm_run_id") @db.Uuid
  contentHash      String      @map("content_hash")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "content_briefs_workspace_id_fkey")
  cluster   TopicCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade, map: "content_briefs_cluster_id_fkey")
  llmRun    LlmRun?      @relation(fields: [llmRunId], references: [id], onDelete: SetNull, map: "content_briefs_llm_run_id_fkey")

  contentItems ContentItem[]

  @@index([workspaceId, status], map: "content_briefs_workspace_id_status_idx")
  @@map("content_briefs")
}

model ContentItem {
  id                String        @id @default(uuid(7)) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  briefId           String        @map("brief_id") @db.Uuid
  slug              String
  title             String
  locale            String        @default("ru")
  productId         String?       @map("product_id") @db.Uuid
  regionId          String?       @map("region_id") @db.Uuid
  status            ContentStatus @default(draft)
  currentRevisionId String?       @unique(map: "content_items_current_revision_id_key") @map("current_revision_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "content_items_workspace_id_fkey")
  brief           ContentBrief     @relation(fields: [briefId], references: [id], onDelete: Cascade, map: "content_items_brief_id_fkey")
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull, map: "content_items_product_id_fkey")
  region          Region?          @relation(fields: [regionId], references: [id], onDelete: SetNull, map: "content_items_region_id_fkey")
  currentRevision ContentRevision? @relation("CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull, map: "content_items_current_revision_id_fkey")

  revisions     ContentRevision[]  @relation("ItemRevisions")
  publications  Publication[]
  ctaPlacements CtaPlacement[]
  leads         Lead[]
  touches       AttributionTouch[]

  @@unique([workspaceId, slug, locale], map: "content_items_workspace_id_slug_locale_key")
  @@index([workspaceId, status], map: "content_items_workspace_id_status_idx")
  @@map("content_items")
}

/// Immutable. A save is a new row, never an update. The history is the audit trail rather
/// than a side effect of one, and `content_hash` is what an approval binds to.
model ContentRevision {
  id              String     @id @default(uuid(7)) @db.Uuid
  workspaceId     String     @map("workspace_id") @db.Uuid
  contentItemId   String     @map("content_item_id") @db.Uuid
  revisionNumber  Int        @map("revision_number")
  bodyMarkdown    String     @map("body_markdown")
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")
  /// SHA-256 of the exact bytes. Editing changes this, which detaches any approval.
  contentHash     String     @map("content_hash")
  authorKind      AuthorKind @map("author_kind")
  authorId        String?    @map("author_id") @db.Uuid
  llmRunId        String?    @map("llm_run_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")

  contentItem ContentItem  @relation("ItemRevisions", fields: [contentItemId], references: [id], onDelete: Cascade, map: "content_revisions_content_item_id_fkey")
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull, map: "content_revisions_author_id_fkey")
  llmRun      LlmRun?      @relation(fields: [llmRunId], references: [id], onDelete: SetNull, map: "content_revisions_llm_run_id_fkey")
  currentFor  ContentItem? @relation("CurrentRevision")

  publications Publication[]

  @@unique([contentItemId, revisionNumber], map: "content_revisions_content_item_id_revision_number_key")
  @@index([contentItemId, createdAt], map: "content_revisions_content_item_id_created_at_idx")
  @@map("content_revisions")
}

enum PublicationTarget {
  internal_website
  export

  @@map("publication_target")
}

enum PublicationStatus {
  pending
  published
  unpublished
  failed

  @@map("publication_status")
}

/// `approval_id` is NOT NULL with a foreign key. This is the product's central invariant
/// expressed as a constraint: publication without an approval is impossible at the schema
/// level, not merely blocked by a code path a new route could bypass.
model Publication {
  id            String            @id @default(uuid(7)) @db.Uuid
  workspaceId   String            @map("workspace_id") @db.Uuid
  contentItemId String            @map("content_item_id") @db.Uuid
  revisionId    String            @map("revision_id") @db.Uuid
  approvalId    String            @map("approval_id") @db.Uuid
  target        PublicationTarget @default(internal_website)
  status        PublicationStatus @default(pending)
  publicUrl     String?           @map("public_url")
  publishedAt   DateTime?         @map("published_at")
  publishedById String?           @map("published_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  contentItem ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade, map: "publications_content_item_id_fkey")
  revision    ContentRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, map: "publications_revision_id_fkey")
  approval    Approval        @relation(fields: [approvalId], references: [id], onDelete: Restrict, map: "publications_approval_id_fkey")
  publishedBy User?           @relation(fields: [publishedById], references: [id], onDelete: SetNull, map: "publications_published_by_id_fkey")

  @@index([workspaceId, status], map: "publications_workspace_id_status_idx")
  @@index([contentItemId], map: "publications_content_item_id_idx")
  @@map("publications")
}

model CtaPlacement {
  id            String   @id @default(uuid(7)) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  contentItemId String   @map("content_item_id") @db.Uuid
  variant       String
  formSlug      String   @map("form_slug")
  createdAt     DateTime @default(now()) @map("created_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade, map: "cta_placements_content_item_id_fkey")

  @@index([contentItemId], map: "cta_placements_content_item_id_idx")
  @@map("cta_placements")
}

// =============================================================================
// APPROVALS
// =============================================================================

enum ApprovalSubjectType {
  service_request_plan
  content_revision
  publication

  @@map("approval_subject_type")
}

enum ApprovalDecision {
  approved
  rejected

  @@map("approval_decision")
}

/// Author and approver are recorded separately even when they are the same person, so the
/// "approver is not the author" policy can be switched on later without re-labelling history.
model Approval {
  id          String              @id @default(uuid(7)) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  subjectType ApprovalSubjectType @map("subject_type")
  subjectId   String              @map("subject_id") @db.Uuid
  /// The hash of the subject at the moment of the decision. A later edit changes the
  /// subject's hash, which detaches this approval without anything having to remember.
  contentHash String              @map("content_hash")
  decision    ApprovalDecision
  decidedById String              @map("decided_by_id") @db.Uuid
  decidedAt   DateTime            @default(now()) @map("decided_at")
  note        String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "approvals_workspace_id_fkey")
  decidedBy User      @relation(fields: [decidedById], references: [id], map: "approvals_decided_by_id_fkey")

  publications Publication[]

  @@index([subjectType, subjectId], map: "approvals_subject_type_subject_id_idx")
  @@index([workspaceId, decidedAt], map: "approvals_workspace_id_decided_at_idx")
  @@map("approvals")
}

// =============================================================================
// LEADS AND ATTRIBUTION
// =============================================================================

enum LeadStatus {
  new
  qualified
  contacted
  converted
  rejected
  spam

  @@map("lead_status")
}

/// The one table holding personal data. It never reaches the LLM provider layer — enforced by
/// rule AC-2 and by PII_TO_LLM_ALLOWED=false. Consent columns are NOT NULL: a lead without a
/// recorded consent moment cannot exist, and the API rejects the submission rather than
/// storing one.
model Lead {
  id          String @id @default(uuid(7)) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  productId        String?          @map("product_id") @db.Uuid
  volume           Decimal?         @db.Decimal(14, 3)
  volumeUnit       MeasurementUnit? @map("volume_unit")
  deliveryRegionId String?          @map("delivery_region_id") @db.Uuid
  deliveryBasisId  String?          @map("delivery_basis_id") @db.Uuid

  companyName String? @map("company_name")
  inn         String?
  contactName String  @map("contact_name")
  phone       String?
  email       String?
  message     String?

  landingPath   String? @map("landing_path")
  contentItemId String? @map("content_item_id") @db.Uuid
  utmSource     String? @map("utm_source")
  utmMedium     String? @map("utm_medium")
  utmCampaign   String? @map("utm_campaign")
  utmContent    String? @map("utm_content")
  utmTerm       String? @map("utm_term")

  consentAt            DateTime @map("consent_at")
  consentTextVersion   String   @map("consent_text_version")
  privacyPolicyVersion String   @map("privacy_policy_version")

  /// Normalized contact plus product. A repeat submission adds a touch, not a second lead.
  dedupeHash String     @map("dedupe_hash")
  status     LeadStatus @default(new)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "leads_workspace_id_fkey")
  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull, map: "leads_product_id_fkey")
  deliveryRegion Region?        @relation(fields: [deliveryRegionId], references: [id], onDelete: SetNull, map: "leads_delivery_region_id_fkey")
  deliveryBasis  DeliveryBasis? @relation(fields: [deliveryBasisId], references: [id], onDelete: SetNull, map: "leads_delivery_basis_id_fkey")
  contentItem    ContentItem?   @relation(fields: [contentItemId], references: [id], onDelete: SetNull, map: "leads_content_item_id_fkey")

  touches         AttributionTouch[]
  serviceRequests ServiceRequest[]

  @@unique([workspaceId, dedupeHash], map: "leads_workspace_id_dedupe_hash_key")
  @@index([workspaceId, createdAt], map: "leads_workspace_id_created_at_idx")
  @@index([workspaceId, status], map: "leads_workspace_id_status_idx")
  @@map("leads")
}

enum TouchPosition {
  first
  last
  middle

  @@map("touch_position")
}

/// `visitor_id` is a random identifier carrying no personal data. It is not an account and
/// grants nothing; it exists to link page views to a lead after the fact.
model AttributionTouch {
  id            String         @id @default(uuid(7)) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  visitorId     String         @map("visitor_id") @db.Uuid
  leadId        String?        @map("lead_id") @db.Uuid
  contentItemId String?        @map("content_item_id") @db.Uuid
  path          String
  referrer      String?
  utmSource     String?        @map("utm_source")
  utmMedium     String?        @map("utm_medium")
  utmCampaign   String?        @map("utm_campaign")
  utmContent    String?        @map("utm_content")
  utmTerm       String?        @map("utm_term")
  position      TouchPosition?
  occurredAt    DateTime       @default(now()) @map("occurred_at")

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade, map: "attribution_touches_lead_id_fkey")
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull, map: "attribution_touches_content_item_id_fkey")

  @@index([visitorId, occurredAt], map: "attribution_touches_visitor_id_occurred_at_idx")
  @@index([leadId], map: "attribution_touches_lead_id_idx")
  @@index([workspaceId, contentItemId], map: "attribution_touches_workspace_id_content_item_id_idx")
  @@map("attribution_touches")
}

// =============================================================================
// EVIDENCE REGISTRY (GEO wave, unit 1)
//
// Facts a human verified against a source before they can appear in content
// (README "Следующие шаги" step 5, docs/GEO.md). A claim exists to be cited,
// not paraphrased: every statement points at a source, and every citation
// pinpoints where in the source the fact is supported.
//
// Rows are immutable. A correction supersedes: it creates a new claim and links
// the old one to it, so history stays readable and a citation never silently
// changes its meaning. Only a claim that is verified and not superseded is
// usable by content; the predicate lives in the evidence module domain.
// =============================================================================

enum EvidenceSourceKind {
  official_standard
  producer_document
  regulatory_document
  price_list
  industry_publication
  expert_statement
  other

  @@map("evidence_source_kind")
}

model EvidenceSource {
  id           String             @id @default(uuid(7)) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  title        String
  kind         EvidenceSourceKind
  url          String?
  publishedAt  DateTime?          @map("published_at")
  retrievedAt  DateTime?          @map("retrieved_at")
  /// A source is usable only after a human has checked it. The checker is recorded
  /// separately from the creator, even when it is the same person.
  verifiedAt   DateTime?          @map("verified_at")
  verifiedById String?            @map("verified_by_id") @db.Uuid
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "evidence_sources_workspace_id_fkey")
  verifiedBy User?     @relation("EvidenceSourceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull, map: "evidence_sources_verified_by_id_fkey")

  claims Claim[]

  @@index([workspaceId, kind], map: "evidence_sources_workspace_id_kind_idx")
  @@map("evidence_sources")
}

model Claim {
  id             String    @id @default(uuid(7)) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  sourceId       String    @map("source_id") @db.Uuid
  /// The fact statement in Russian. Never edited in place: a correction is a new
  /// claim that supersedes this one.
  statement      String
  /// SHA-256 of the statement. The deduplication key — a btree unique index over
  /// long Russian text would exceed the index row size limit.
  statementHash  String    @map("statement_hash")
  /// Optional open category (for example "характеристика", "цена"). An open text
  /// column, not an enum: the vocabulary is a workspace concern.
  category       String?
  /// Verified by a human against the source. Only verified, non-superseded claims
  /// are usable by content.
  verifiedAt     DateTime? @map("verified_at")
  verifiedById   String?   @map("verified_by_id") @db.Uuid
  supersededById String?   @map("superseded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "claims_workspace_id_fkey")
  source      EvidenceSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade, map: "claims_source_id_fkey")
  verifiedBy  User?           @relation("ClaimVerifier", fields: [verifiedById], references: [id], onDelete: SetNull, map: "claims_verified_by_id_fkey")
  supersededBy Claim?         @relation("ClaimSupersede", fields: [supersededById], references: [id], onDelete: SetNull, map: "claims_superseded_by_id_fkey")
  supersedes  Claim[]         @relation("ClaimSupersede")

  citations Citation[]

  @@unique([workspaceId, sourceId, statementHash], map: "claims_workspace_id_source_id_statement_hash_key")
  @@index([workspaceId, createdAt], map: "claims_workspace_id_created_at_idx")
  @@map("claims")
}

model Citation {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  claimId     String   @map("claim_id") @db.Uuid
  /// Where exactly in the source: page, section, table, paragraph — enough for a
  /// person to find the fact again.
  location    String
  /// The supporting excerpt, kept short. Never personal data.
  quote       String?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "claim_citations_workspace_id_fkey")
  claim     Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade, map: "claim_citations_claim_id_fkey")

  @@index([claimId], map: "claim_citations_claim_id_idx")
  @@map("claim_citations")
}

// =============================================================================
// DURABLE OUTBOX
//
// Backend machinery rather than product data: no workspace scope, no user ownership.
// A row is work that must not be lost: brief generation, draft generation, publication
// and CDN invalidation travel through here (docs/ARCHITECTURE.md section 5).
//
// Claim protocol: a worker claims the row with a fencing token and a lease. Complete and
// fail both require the matching token, so a worker whose lease expired can no longer
// touch the row; a new claim preserves the attempt counter. `task_type` is an open set
// validated in code against the task registry, not a database enum.
// =============================================================================

enum TaskOutboxStatus {
  pending
  running
  dead

  @@map("task_outbox_status")
}

model TaskOutbox {
  id           String           @id @default(uuid(7)) @db.Uuid
  taskType     String           @map("task_type")
  /// The task's arguments. Written when the work is scheduled, read by the worker.
  payload      Json
  /// Enqueueing the same logical work twice must produce one row: the key is the
  /// enqueuer's responsibility (for example "brief:<briefId>").
  dedupeKey    String           @unique(map: "task_outbox_dedupe_key_key") @map("dedupe_key")
  status       TaskOutboxStatus @default(pending)
  attempts     Int              @default(0)
  maxAttempts  Int              @default(8) @map("max_attempts")
  /// Retry scheduling. A failed task becomes claimable again only after this moment.
  availableAt  DateTime         @default(now()) @map("available_at")
  /// While running, the lease bounds the claim. Expired leases are reclaimed by the
  /// next claim without resetting the attempt counter.
  leaseUntil   DateTime?        @map("lease_until")
  /// The claim's identity. Complete and fail require it; a mismatch means the lease
  /// was lost and the operation is ignored.
  fencingToken String?          @map("fencing_token")
  lastError    String?          @map("last_error")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([status, availableAt], map: "task_outbox_status_available_at_idx")
  @@map("task_outbox")
}

// =============================================================================
// LLM RUNS AND AUDIT
// =============================================================================

enum LlmRunPurpose {
  brief_generation
  draft_generation
  plan_generation

  @@map("llm_run_purpose")
}

enum LlmRunStatus {
  succeeded
  failed
  timed_out
  skipped

  @@map("llm_run_status")
}

/// One row per model call. Without it the cost of a piece of content is invisible from day
/// one. `prompt_hash` rather than the prompt: enough to correlate a bad output with its input
/// without copying drafts and keyword sets into a retained log.
model LlmRun {
  id             String        @id @default(uuid(7)) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  provider       String
  model          String
  purpose        LlmRunPurpose
  promptHash     String        @map("prompt_hash")
  inputTokens    Int?          @map("input_tokens")
  outputTokens   Int?          @map("output_tokens")
  /// Integer minor units, so accumulated cost never drifts.
  costMinorUnits Int?          @map("cost_minor_units")
  costCurrency   String?       @map("cost_currency")
  latencyMs      Int?          @map("latency_ms")
  status         LlmRunStatus
  errorCode      String?       @map("error_code")
  createdAt      DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "llm_runs_workspace_id_fkey")

  plans     ServiceRequestPlan[]
  briefs    ContentBrief[]
  revisions ContentRevision[]

  @@index([workspaceId, createdAt], map: "llm_runs_workspace_id_created_at_idx")
  @@index([workspaceId, purpose], map: "llm_runs_workspace_id_purpose_idx")
  @@map("llm_runs")
}

/// Append-only record of decisions that matter: approvals, publications, role changes and
/// changes to the compliance guards.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  subjectType String   @map("subject_type")
  subjectId   String?  @map("subject_id") @db.Uuid
  /// Context, never personal data or secret values.
  metadata    Json     @default("{}")
  occurredAt  DateTime @default(now()) @map("occurred_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "audit_log_workspace_id_fkey")
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull, map: "audit_log_actor_id_fkey")

  @@index([workspaceId, occurredAt], map: "audit_log_workspace_id_occurred_at_idx")
  @@index([subjectType, subjectId], map: "audit_log_subject_type_subject_id_idx")
  @@map("audit_log")
}
